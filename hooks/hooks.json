{
  "description": "Tautology hunt and copied-code search before each answer",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "set _=' && \"%CLAUDE_PLUGIN_ROOT%\\bin\\py.cmd\" \"%CLAUDE_PLUGIN_ROOT%\\skills\\tautology\\hooks\\edit_gate.py\" & exit /b & rem ' ; exec sh \"$CLAUDE_PLUGIN_ROOT/bin/py.sh\" \"$CLAUDE_PLUGIN_ROOT/skills/tautology/hooks/edit_gate.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set _=' && \"%CLAUDE_PLUGIN_ROOT%\\bin\\py.cmd\" \"%CLAUDE_PLUGIN_ROOT%\\skills\\tautology\\hooks\\stop_gate.py\" & exit /b & rem ' ; exec sh \"$CLAUDE_PLUGIN_ROOT/bin/py.sh\" \"$CLAUDE_PLUGIN_ROOT/skills/tautology/hooks/stop_gate.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set _=' && \"%CLAUDE_PLUGIN_ROOT%\\bin\\py.cmd\" \"%CLAUDE_PLUGIN_ROOT%\\skills\\modular\\hooks\\modular_gate.py\" & exit /b & rem ' ; exec sh \"$CLAUDE_PLUGIN_ROOT/bin/py.sh\" \"$CLAUDE_PLUGIN_ROOT/skills/modular/hooks/modular_gate.py\""
          }
        ]
      }
    ]
  }
}
