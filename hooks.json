{
  "tautology": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd bin && (py.cmd ../skills/tautology/hooks/edit_gate.py 2>nul || sh py.sh ../skills/tautology/hooks/edit_gate.py)"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "cd bin && (py.cmd ../skills/modular/hooks/modular_gate.py 2>nul || sh py.sh ../skills/modular/hooks/modular_gate.py)"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "cd bin && (py.cmd ../skills/tautology/hooks/stop_gate.py 2>nul || sh py.sh ../skills/tautology/hooks/stop_gate.py)",
        "timeout": 90
      }
    ]
  }
}
